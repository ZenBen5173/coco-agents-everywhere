# ─────────────────────────────────────────────────────────────────────────────
# COCO — environment
#
#   cp .env.example .env   then fill in the four blocks below.
#   Never commit .env. Nothing here belongs in browser code except NEXT_PUBLIC_*.
# ─────────────────────────────────────────────────────────────────────────────


# ── MODEL · one provider ─────────────────────────────────────────────────────
# OpenRouter (used for the hackathon build). Any tool-capable model slug works.
MODEL_PROVIDER=openrouter
OPENROUTER_API_KEY=
MODEL=openai/gpt-5.6-sol
# Or OpenAI directly:  MODEL_PROVIDER=openai  OPENAI_API_KEY=…  MODEL=gpt-5.6-sol
# Or Anthropic:        MODEL_PROVIDER=anthropic  ANTHROPIC_API_KEY=…  MODEL=anthropic/claude-sonnet-5

# The team's timezone. Every "tomorrow", "Friday 5pm" resolves in this zone.
USER_TIMEZONE=Asia/Kuala_Lumpur


# ── SLACK · the listener (apps/listener) ─────────────────────────────────────
# Your own Slack app, Socket Mode on, bot invited to the channel.
# Bot scopes: channels:history, channels:read, users:read, app_mentions:read.
# Event subscription: message.channels.
SLACK_BOT_TOKEN=xoxb-
SLACK_APP_TOKEN=xapp-
# The one channel it reads. Find the id in the channel's details in Slack.
SLACK_CHANNEL_ID=
SLACK_CHANNEL_NAME=
# How long the channel must be quiet before a batch is read (ms).
EXTRACT_DEBOUNCE_MS=8000


# ── SLACK · the reply surface (apps/channel, CopilotKit managed Channel) ─────
# Optional. Intelligence hosts the Slack connection; no tunnel, no xapp token.
# Create the Channel at https://intelligence.copilotkit.ai, copy its Code and a
# project-scoped API key.
INTELLIGENCE_API_KEY=
CHANNEL_CODE=
LOG_LEVEL=debug
PORT=3000
# Where the "Open review" button in Slack cards points.
WEB_URL=http://127.0.0.1:3100


# ── SUPABASE ─────────────────────────────────────────────────────────────────
# Project Settings → API. The service key is server-side only.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_ANON_KEY=
# The browser reads the queue and the board with the anon key (RLS is off for
# the hackathon; every write still goes through the server).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=


# ── GOOGLE CALENDAR (optional) ───────────────────────────────────────────────
# Approved items with a due date become events on one shared calendar.
# An OAuth client (Web application) from Google Cloud, with
#   http://127.0.0.1:3100/api/google/callback   listed as a redirect URI.
# Then click "Connect Google Calendar" in the app sidebar. Or paste a refresh
# token here to skip the button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary


# ── OPTIONAL ─────────────────────────────────────────────────────────────────
# Exa web search for the Slack agent. Unset = tool not registered.
EXA_API_KEY=
EXA_SEARCH_TYPE=fast
